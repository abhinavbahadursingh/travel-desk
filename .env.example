# Copy to .env and fill in
#
# Database — SQLite (default, local dev + Vitest/Playwright test harness):
DATABASE_URL="file:./dev.db"
#
# Database — PostgreSQL (production; schema at prisma/schema.postgres.prisma,
# migrations at prisma/migrations/). Switch by pointing DATABASE_URL at a
# postgres:// URL and running:
#   npm run db:pg:generate
#   npm run db:pg:migrate:deploy
# A one-shot data migration from local dev.db to Postgres:
#   SQLITE_URL="file:./prisma/dev.db" POSTGRES_URL="postgresql://…" \
#     npm run db:migrate:from-sqlite
# DATABASE_URL="postgresql://user:pass@host:5432/travel_agent"

# Groq API key — AI reasoning engine (https://console.groq.com)
GROQ_API_KEY="gsk_..."

# Optional: override the default Groq model
# GROQ_MODEL="llama-3.3-70b-versatile"

# Tavily API key — primary real-time web search (https://tavily.com)
TAVILY_API_KEY="tvly-..."

# Optional: Google Maps Platform key — used for real cab routing
# (distance + duration). If unset, cab search falls back to Tavily on
# ride-hailing provider domains. No fare is ever fabricated.
# GOOGLE_MAPS_API_KEY=""

# Optional: display rate used to convert search results into the trip currency.
# Domestic India trips are always shown in INR; other trips in USD.
# INR_PER_USD="83"

# Local dev identity. The seed creates only this account — there are no demo
# users or sample trips. Set these to your real details.
DEV_USER_EMAIL="you@company.com"
DEV_USER_NAME="Your Name"
# Values: employee | manager | travel_admin | super_admin
DEV_USER_ROLE="travel_admin"
# Optional: department used for departmental approval routing.
# DEV_USER_DEPARTMENT="Sales"
# Optional: your real Slack member ID for the /travel slash command.
# DEV_SLACK_USER_ID="U..."

# Slack slash command signing secret (optional; verification skipped if blank)
SLACK_SIGNING_SECRET=""

# ─── Phase 3: outbound notification delivery ──────────────────────────────
# Enables real email delivery via Resend. If blank, email outbox rows are
# never enqueued and in-app notifications continue to work.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Travel Agent <noreply@your-domain.com>"

# Enables outbound Slack delivery. Either (or both) can be set:
#   SLACK_BOT_TOKEN  — DMs the recipient's User.slackUserId via chat.postMessage.
#   SLACK_WEBHOOK_URL — posts to a workspace channel; used as a fallback
#                      for recipients with no slackUserId and for admin
#                      broadcast events (trip ready for booking, cancellation
#                      requested).
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Absolute base URL embedded in outbound links (emails + Slack). Falls back to
# the relative path if unset.
# APP_BASE_URL="https://travel.your-domain.com"
